<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

@model IEnumerable<TallerMecanico.Models.Producto>

<div class="container mt-4">
    <!-- Partial View de resumen -->
    <partial name="_ResumenBox" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Productos</h2>
        
        <!-- 🔒 Oculta el botón a usuarios sin rol Admin -->
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">➕ Nuevo Producto</a>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <!-- Columna condicional de acciones solo si es Admin -->
                    @if (User.IsInRole("Admin"))
                    {
                        <th class="text-center">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Nombre</td>
                            <td>$@item.Precio.ToString("F2")</td>
                            
                            <!-- 🔒 Botones de Editar y Eliminar solo visibles para el Admin -->
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">✏️ Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">🗑️ Eliminar</a>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(User.IsInRole("Admin") ? 4 : 3)" class="text-center text-muted py-3">
                            No hay productos registrados aún.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>