<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
@model IEnumerable<TallerMecanico.Models.Producto>

<div class="container mt-4">
    <partial name="_ResumenBox" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Productos</h2>
        <div>
            <!-- Botón AJAX -->
            <button type="button" class="btn btn-info me-2" onclick="cargarInventarioAjax()">
                🔄 Cargar Inventario vía AJAX
            </button>
            
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary">➕ Nuevo Producto</a>
            }
        </div>
    </div>

    <!-- Contenedor donde se cargarán dinámicamente los productos -->
    <div id="listaProductos" class="mt-3"></div>

    <!-- Tabla tradicional MVC -->
    <div class="table-responsive mt-3">
        <table class="table table-striped table-hover shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Precio</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th class="text-center">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Nombre</td>
                            <td>$@item.Precio.ToString("F2")</td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">✏️ Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">🗑️ Eliminar</a>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<!-- Script directo sin depender de Layout o RenderSection -->
<script>
    async function cargarInventarioAjax() {
        const contenedor = document.getElementById("listaProductos");
        if (!contenedor) return;

        contenedor.innerHTML = '<div class="spinner-border text-primary mb-3" role="status"><span class="visually-hidden">Cargando...</span></div>';

        try {
            const respuesta = await fetch("/api/ProductosApi");
            if (!respuesta.ok) throw new Error("Error en la red al obtener los datos");
            
            const datos = await respuesta.json();
            contenedor.innerHTML = "";

            if (datos.length === 0) {
                contenedor.innerHTML = '<div class="alert alert-warning">No hay productos disponibles en la API.</div>';
                return;
            }
            datos.forEach(p => {
                contenedor.innerHTML += `
                    <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <strong>${p.nombre}</strong> - $${p.precio}
                        </div>
                        <span class="badge bg-primary rounded-pill">Stock: ${p.stock ?? 10}</span>
                    </div>`;
            });
        } catch (error) {
            contenedor.innerHTML = `<p class="text-danger">Error: ${error.message}</p>`;
        }
    }
</script>