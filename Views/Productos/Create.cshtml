<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

@model TallerMecanico.ViewModels.ProductoCreateViewModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <h2 class="text-primary mb-3">Registrar Nuevo Producto</h2>

            <form asp-action="Create" method="post" class="card p-4 shadow-sm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold">Nombre del Producto</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Aceite de Motor 20W50" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Precio" class="form-label fw-bold">Precio</label>
                    <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="0.00" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <a href="/Productos" class="btn btn-secondary">Volver</a>
                    <button type="submit" class="btn btn-success">Guardar Registro</button>
                </div>
            </form>
        </div>
    </div>
</div>